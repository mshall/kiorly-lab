// =============================================================================
// FROZEN-v1 (engineering freeze, migration 0002_freeze_v1). Discovery-dependent
// items use NEEDS_HUMAN defaults (Docs/NEEDS_HUMAN.md); a human still has to
// approve the freeze (NH-LB-023). Designed from KX-07 (Kiorly Lab PRD) + KX-09
// events. Change only via new named migrations, never edit an applied one. 2025 kiorex-backend lab-service entities were used as DESIGN
// NOTES only (Docs/DESIGN_NOTES_FROM_2025.md); no code copied (ADR-026).
//
// Conventions
//  - Every business table carries orgId (Kiorly tenant) => tenant isolation
//    (safety control, never a flag). Child tables inherit via parent FK.
//  - Accession is unique per lab (labId + accessionNumber); duplicates rejected
//    by a DB unique index (KLSPC01, stop-ship "duplicate accession accepted").
//  - CustodyEvent is append-only (DB trigger forbids UPDATE/DELETE) (KLSPC03).
//  - A ReleaseRecord must reference a signed ReportVersion (NOT NULL FKs), and a
//    ReportVersion must carry signer + timestamp (DB CHECK) => "result released
//    without QC pass or signature" is structurally impossible (stop-ship).
//  - Results are only releasable when linked to a PASSING QcRun and no open
//    QcBlock exists for the analyte/instrument (enforced in service + DB CHECK
//    on Result.releasedAt requiring qcRunId and medical validator).
// =============================================================================

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ----------------------------------------------------------------- enums ----

enum Edition {
  LITE
  PRO
  CHAIN
}

enum IntegrationMode {
  STANDALONE
  INTEGRATED
}

enum StaffRole {
  OWNER
  LAB_DIRECTOR
  AUTHORIZED_SIGNATORY
  TECHNOLOGIST
  PHLEBOTOMIST
  RECEPTION
  BRANCH_MANAGER
  /// Shift/bench supervisor (standalone LIS).
  SUPERVISOR
  /// Finance officer (standalone LIS).
  FINANCE
}

enum Sex {
  M
  F
  OTHER
  UNKNOWN
}

enum OrderSource {
  WALK_IN
  KIORLY_CLINIC
  KIOREX_BOOKING
  REFERRING_DOCTOR
  /// KLORD02/KLORD05: sample collected by a Kiorly Nurse visit (Nurse is an edition of Kiorly Clinic, ADR-031).
  KIORLY_NURSE
}

enum OrderStatus {
  DRAFT
  AWAITING_COLLECTION
  COLLECTED
  IN_LAB
  PARTIALLY_RESULTED
  AWAITING_VALIDATION
  VALIDATED
  RELEASED
  CANCELLED
}

enum OrderItemStatus {
  PENDING
  IN_PROGRESS
  RESULTED
  VALIDATED
  RELEASED
  CANCELLED
}

enum CollectionType {
  IN_LAB
  HOME
  /// KLORD05: collected by a nurse at the patient's home; custody starts at the nurse's collection time.
  NURSE_VISIT
}

enum HomeCollectionStatus {
  REQUESTED
  SCHEDULED
  EN_ROUTE
  /// @kiorly/field-visit ARRIVED (geostamp = check-in).
  ARRIVED
  COLLECTED
  FAILED
  CANCELLED
  /// BR61: "Leave visit - unsafe"; never a no-show.
  ABORTED_UNSAFE
}

enum SpecimenStatus {
  PENDING_COLLECTION
  COLLECTED
  IN_TRANSIT
  RECEIVED
  PROCESSING
  STORED
  DISPOSED
  REJECTED
}

/// KLSPC03: collected -> transported -> received -> processed -> stored/disposed.
enum CustodyEventType {
  COLLECTED
  TRANSPORT_STARTED
  RECEIVED
  PROCESSING_STARTED
  ALIQUOTED
  STORED
  DISPOSED
  REJECTED
  LABEL_MISMATCH_BLOCKED
}

enum RejectionReason {
  HAEMOLYSED
  INSUFFICIENT_VOLUME
  MISLABELLED
  WRONG_CONTAINER
  CLOTTED
  OTHER
  LIPAEMIC
  LEAKED
  UNLABELLED
  TEMPERATURE_EXCURSION
  STABILITY_EXCEEDED
}

enum InstrumentKind {
  ANALYZER
  MANUAL_BENCH
}

enum QcLevel {
  LEVEL_1
  LEVEL_2
  LEVEL_3
}

/// KLQC02: result of evaluating a QC run against Westgard rules.
enum QcRunStatus {
  PASS
  WARNING
  FAIL
}

enum QcBlockStatus {
  OPEN
  CLEARED
}

enum ResultSource {
  ANALYZER_ASTM
  ANALYZER_HL7
  MANUAL
  /// Derived from other results by a formula (calculated tests).
  CALCULATED
  /// Microbiology / histopathology structured report.
  STRUCTURED
}

enum ResultStatus {
  ENTERED
  TECH_VALIDATED
  MEDICAL_VALIDATED
  RELEASED
  CORRECTED
  REJECTED
}

enum ResultFlag {
  NORMAL
  LOW
  HIGH
  CRITICAL_LOW
  CRITICAL_HIGH
  ABNORMAL
}

enum ReleaseChannel {
  PRINTED
  PATIENT_LINK_OTP
  KIORLY_CLINIC_IMPORT
  /// KLCRIT02: Kiorly Nurse import (for nurse-ordered samples).
  KIORLY_NURSE_IMPORT
  KIOREX_VAULT
  /// Standalone: the referring doctor's portal (needs patient consent like every channel).
  REFERRER_PORTAL
}

enum CriticalAlertStatus {
  OPEN
  ACKNOWLEDGED
  ESCALATED
  CLOSED
}

enum AnalyzerProtocol {
  ASTM_E1394
  HL7_V2
}

enum AnalyzerMessageStatus {
  PARSED
  PARTIAL
  FAILED
}

enum NotificationChannel {
  WHATSAPP
  SMS
  EMAIL
  PUSH
  VOICE
}

enum NotificationPurpose {
  CRITICAL_ALERT
  CRITICAL_ESCALATION
  RESULT_READY
  REPORT_CORRECTED
  COLLECTION_REMINDER
  RECOLLECTION
  REPORT_OTP
  SLA_ALERT
  /// HVSAF (phlebotomist safety): ids only, no PHI.
  SAFETY_ALERT
  /// Invoice email, payment link and payment receipt (no clinical content).
  BILLING
}

enum SafetyAlertKind {
  NO_ANSWER
  SOS
  UNSAFE_ABORT
}

enum NotificationStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
}

enum PaymentMethod {
  CASH
  CARD
  /// Bank transfer / cheque: used for B2B and insurance settlements.
  TRANSFER
  CHEQUE
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum LedgerAccount {
  CASH_DRAWER
  CARD_CLEARING
  RECEIVABLES
  REVENUE
  VAT_PAYABLE
  REFUNDS
  BANK
}

enum OutboxStatus {
  PENDING
  SENT
  FAILED
}

// ------------------------------------------------------- tenancy / staff ----

model Tenant {
  id                        String          @id @default(cuid())
  externalOrgId             String?         @unique
  name                      String
  edition                   Edition         @default(LITE)
  marketCode                String          @default("EG")
  slug                      String?         @unique
  currency                  String          @default("EGP")
  /// Market-pack VAT line rate (percent). NEEDS_HUMAN (NH-LB-004): engineering default 0; shown on invoices/exports only.
  vatRatePercent            Decimal         @default(0) @db.Decimal(5, 2)
  /// NH-LB-003: referring-doctor statements only where counsel confirms they are lawful. Off by default.
  referringDoctorStatements Boolean         @default(false)
  /// STANDALONE: no external service is contacted or accepted (no outbox events, integration endpoints refuse). INTEGRATED: optional Kiorly Clinic / Kiorex / Nurse links.
  /// Existing tenants default to INTEGRATED (unchanged behaviour); new self-serve tenants start STANDALONE.
  integrationMode           IntegrationMode @default(INTEGRATED)
  /// UI / report default language.
  defaultLocale             String          @default("ar")
  /// QC coverage window for a result (hours). NEEDS_HUMAN (NH-LB-005): pathologist to confirm.
  qcValidityHours           Int             @default(24)
  /// HVSAF: organisation safety contact for phlebotomist alerts (safety control, never a flag). Required before a collector can leave.
  safetyContactName         String?
  safetyContactPhone        String?
  /// HVCFG01/03: travel buffers around a home collection (minutes, default 30/30) and the optional daily cap per phlebotomist.
  homeBufferBeforeMin       Int             @default(30)
  homeBufferAfterMin        Int             @default(30)
  homeDailyCap              Int?
  createdAt                 DateTime        @default(now())

  labs  Lab[]
  staff StaffUser[]
}

/// A lab site (branch). Accession numbers are unique per Lab.
model Lab {
  id                     String   @id @default(cuid())
  orgId                  String
  name                   String
  licenceNo              String?
  address                String?
  /// Prefix of accession numbers for this lab.
  code                   String   @default("LAB")
  createdAt              DateTime @default(now())
  /// Reception appointments: capacity per slot and opening hours (UTC hours, simple model).
  appointmentCapacity    Int      @default(4)
  appointmentSlotMinutes Int      @default(30)
  openingHour            Int      @default(8)
  closingHour            Int      @default(20)
  /// HVBK01 (@kiorly/field-visit zones): districts this lab collects in. Empty = no restriction configured yet (NH-LB-034).
  coverageDistricts      String[] @default([])
  maxTravelMinutes       Int?
  startDistrictId        String?
  /// Nested { fromDistrict: { toDistrict: minutes } } travel matrix.
  travelMatrix           Json?

  tenant Tenant @relation(fields: [orgId], references: [id])

  specimens   Specimen[]
  instruments Instrument[]
  slots       CollectionSlot[]

  @@unique([orgId, code])
  @@index([orgId])
}

model StaffUser {
  id                 String    @id @default(cuid())
  orgId              String
  subject            String?
  /// Verified E.164 phone used to link the staff row to its Kiorex Passport on first Passport sign-in (identity only, never clinical).
  phone              String?
  email              String?
  displayName        String
  role               StaffRole
  /// Labs this user may work in (empty = all labs of the tenant).
  labIds             String[]
  /// AUTHORIZED_SIGNATORY / LAB_DIRECTOR: medical validation credentials.
  signatoryLicenceNo String?
  active             Boolean   @default(true)
  createdAt          DateTime  @default(now())

  tenant Tenant @relation(fields: [orgId], references: [id])

  @@unique([orgId, subject])
  @@unique([orgId, email])
  @@unique([orgId, phone])
  @@index([orgId, role])
  @@index([phone])
}

/// A staff web session started with Kiorex Passport. The product session JWT carries this row id (`jti`); a back-channel logout (or
/// deactivating the staff member) sets `revokedAt`, which ends the session at the next request. Identity only: no tokens are stored.
model PassportSession {
  id            String    @id @default(cuid())
  orgId         String
  staffId       String
  /// Passport subject (`sub`) and session id (`sid` of the id_token) that a logout_token refers to.
  sub           String
  sid           String?
  createdAt     DateTime  @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?
  revokedReason String?

  @@index([sid])
  @@index([sub])
  @@index([staffId])
}

/// Back-channel logout record for raw Passport access tokens (staff mobile app): a token whose `sid` (or `sub`, issued before `revokedAt`) is listed is refused.
model PassportRevocation {
  id        String   @id @default(cuid())
  /// SID | SUB
  kind      String
  value     String
  revokedAt DateTime @default(now())
  expiresAt DateTime

  @@unique([kind, value])
}

/// jti of every accepted logout_token (replay protection, shared by all API instances). Rows are purged after the token's own expiry.
model LogoutTokenSeen {
  jti       String   @id
  seenAt    DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
}

// ------------------------------------------------------------- catalogue ----

/// KLQC03 reportable analyte (e.g. Hb, WBC, ALT).
model Analyte {
  id            String           @id @default(cuid())
  orgId         String
  code          String
  nameEn        String
  nameAr        String?
  unit          String?
  /// Decimal places for reporting.
  precision     Int              @default(1)
  /// Codes this analyte is known by on analyzers (ASTM/HL7 universal test ids).
  analyzerCodes String[]
  active        Boolean          @default(true)
  /// NUMERIC | TEXT (free) | SEMI_QUANT (ordered scale, e.g. Neg/Trace/1+..4+) | CHOICE (pick from allowedValues).
  valueType     AnalyteValueType @default(NUMERIC)
  allowedValues String[]         @default([])
  /// Subset of allowedValues that are NORMAL (anything else flags ABNORMAL).
  normalValues  String[]         @default([])
  /// Calculated analyte: expression over analyte codes, e.g. "TC - HDL - TG/5". Built-ins: AGE (years), MALE (1/0).
  formula       String?

  testAnalytes       TestAnalyte[]
  referenceIntervals ReferenceInterval[]
  criticalRules      CriticalRule[]
  qcMaterials        QcMaterialLevel[]
  results            Result[]
  autoVerification   AutoVerificationRule[]

  @@unique([orgId, code])
}

/// KLORD01: code, name AR/EN, specimen type, container, volume, prep, TAT, price.
model TestDefinition {
  id                 String     @id @default(cuid())
  orgId              String
  code               String
  nameEn             String
  nameAr             String?
  specimenType       String
  container          String?
  volumeMl           Decimal?   @db.Decimal(6, 2)
  fastingRequired    Boolean    @default(false)
  prepInstructionsEn String?
  prepInstructionsAr String?
  /// Turnaround time target in minutes (KLBIZ02 SLA alerts).
  tatMinutes         Int?
  price              Decimal    @default(0) @db.Decimal(14, 2)
  /// Sent to a referral lab (send-out) instead of run in-house.
  sendOut            Boolean    @default(false)
  active             Boolean    @default(true)
  section            LabSection @default(GENERAL)

  analytes     TestAnalyte[]
  orderItems   OrderItem[]
  packageItems TestPackageItem[]

  @@unique([orgId, code])
}

model TestAnalyte {
  testId    String
  analyteId String
  position  Int    @default(0)

  test    TestDefinition @relation(fields: [testId], references: [id], onDelete: Cascade)
  analyte Analyte        @relation(fields: [analyteId], references: [id])

  @@id([testId, analyteId])
}

/// KLBIZ01: check-up packages.
model TestPackage {
  id     String  @id @default(cuid())
  orgId  String
  code   String
  nameEn String
  nameAr String?
  price  Decimal @db.Decimal(14, 2)

  items TestPackageItem[]

  @@unique([orgId, code])
}

model TestPackageItem {
  packageId String
  testId    String

  package TestPackage    @relation(fields: [packageId], references: [id], onDelete: Cascade)
  test    TestDefinition @relation(fields: [testId], references: [id])

  @@id([packageId, testId])
}

/// KLQC03: reference intervals by age/sex with versioning (never edited in place).
model ReferenceInterval {
  id            String    @id @default(cuid())
  orgId         String
  analyteId     String
  sex           Sex?
  ageMinDays    Int       @default(0)
  ageMaxDays    Int?
  low           Decimal?  @db.Decimal(12, 4)
  high          Decimal?  @db.Decimal(12, 4)
  version       Int       @default(1)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  /// Physiological condition this interval applies to (e.g. PREGNANT_T1); null = general population.
  condition     String?
  /// NH-LB-013: source and licence of the interval.
  source        String?
  createdBy     String?

  analyte Analyte @relation(fields: [analyteId], references: [id])

  @@unique([analyteId, sex, ageMinDays, condition, version])
  @@index([orgId, analyteId])
}

/// KLCRIT01: critical-value list per test/analyte with acknowledgement window.
model CriticalRule {
  id               String   @id @default(cuid())
  orgId            String
  analyteId        String
  criticalLow      Decimal? @db.Decimal(12, 4)
  criticalHigh     Decimal? @db.Decimal(12, 4)
  /// Acknowledge within N minutes or escalate (PRD example: 30).
  ackWithinMinutes Int      @default(30)
  active           Boolean  @default(true)

  analyte Analyte @relation(fields: [analyteId], references: [id])

  @@index([orgId, analyteId])
}

// ---------------------------------------------------------------- orders ----

/// Minimal patient reference (KLORD03: two identifiers). No clinical record is kept here beyond the order.
model PatientRef {
  id              String    @id @default(cuid())
  orgId           String
  externalId      String?
  fullName        String
  dateOfBirth     DateTime? @db.Date
  sex             Sex       @default(UNKNOWN)
  phone           String?
  nationalIdHash  String?
  nationalIdLast4 String?
  preferredLocale String    @default("ar")
  createdAt       DateTime  @default(now())
  /// Standalone patient registry (no Kiorly Clinic needed): lab medical record number, contact + clinical context.
  mrn             String?
  email           String?
  address         String?
  city            String?
  nationality     String?
  bloodGroup      String?
  notes           String?
  /// Reference-interval conditions, e.g. PREGNANT_T1, POSTMENOPAUSAL, NEONATE.
  conditions      String[]  @default([])
  active          Boolean   @default(true)
  /// Duplicate merge: the surviving record (this row stays for audit, hidden from search).
  mergedIntoId    String?
  mergedAt        DateTime?
  updatedAt       DateTime  @default(now()) @updatedAt

  orders   LabOrder[]
  consents PatientConsent[]

  @@unique([orgId, mrn])
  @@index([orgId, phone])
  @@index([orgId, externalId])
  @@index([orgId, nationalIdHash])
}

model LabOrder {
  id                   String           @id @default(cuid())
  orgId                String
  labId                String
  patientId            String
  source               OrderSource
  status               OrderStatus      @default(DRAFT)
  /// Idempotency for external orders (Kiorly Clinic CL06 order id / Kiorex booking id).
  sourceRef            String?
  /// KLORD03: two identifiers verified at registration.
  identityVerified     Boolean          @default(false)
  identifiersChecked   String[]
  referringDoctorName  String?
  referringDoctorRef   String?
  /// KLORD03/KLCRIT02: consent for result sharing, per channel. Release channels check this.
  consentShareChannels ReleaseChannel[]
  consentCapturedAt    DateTime?
  priority             String           @default("ROUTINE")
  /// Human readable number, unique per tenant (ORD-YYYY-000001).
  orderNumber          String?
  collectionType       CollectionType   @default(IN_LAB)
  b2bAccountId         String?
  /// Ordering clinician contact for critical alerts (KLCRIT01); phone only, never clinical data.
  referringDoctorPhone String?
  /// Directory entry of the referring doctor/clinic (commission, delivery preferences).
  referrerId           String?
  /// Clinical context for the pathologist (free text, PHI) and ICD-10 hints; fasting state captured at the desk.
  clinicalInfo         String?
  icdCodes             String[]         @default([])
  fastingConfirmed     Boolean?
  cancelReason         String?
  cancelledAt          DateTime?
  cancelledBy          String?
  /// Incremented on every audited edit (OrderRevision).
  revision             Int              @default(0)
  appointmentId        String?
  createdBy            String
  createdAt            DateTime         @default(now())

  patient         PatientRef       @relation(fields: [patientId], references: [id])
  items           OrderItem[]
  homeCollection  HomeCollection?
  nurseCollection NurseCollection?
  specimens       Specimen[]
  reports         ReportVersion[]
  invoices        Invoice[]
  b2bAccount      B2bAccount?      @relation(fields: [b2bAccountId], references: [id])
  referrer        Referrer?        @relation(fields: [referrerId], references: [id])

  @@unique([orgId, orderNumber])
  @@unique([orgId, source, sourceRef])
  @@index([orgId, labId, status])
}

model OrderItem {
  id          String          @id @default(cuid())
  orderId     String
  testId      String
  status      OrderItemStatus @default(PENDING)
  price       Decimal         @db.Decimal(14, 2)
  /// Specimen this item runs on (set at specimen creation).
  specimenId  String?
  packageCode String?
  createdAt   DateTime        @default(now())

  order       LabOrder       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  test        TestDefinition @relation(fields: [testId], references: [id])
  results     Result[]
  sendOutCost SendOutCost?
  slaAlert    SlaAlert?

  @@index([orderId])
}

/// KLORD04: slot, address, phlebotomist, route, confirmation with photo of labels.
model HomeCollection {
  id             String               @id @default(cuid())
  orgId          String
  orderId        String               @unique
  status         HomeCollectionStatus @default(REQUESTED)
  slotStart      DateTime
  slotEnd        DateTime
  address        String
  geo            Json?
  phlebotomistId String?
  routeSequence  Int?
  confirmedAt    DateTime?
  /// Label photo storage key (NH-LB-011: privacy handling pending).
  labelPhotoKey  String?
  contactPhone   String?
  failureReason  String?
  slotId         String?
  routeDate      DateTime?            @db.Date
  /// Market-pack district id of the address (coverage check, coarse reporting).
  districtId     String?
  onMyWayAt      DateTime?
  arrivedAt      DateTime?
  /// Set at any terminal state; address and phone are masked 24 h after it (BR52).
  endedAt        DateTime?
  abortReason    String?
  /// @kiorly/field-visit HistoryEntry[] (coarse geostamps only).
  history        Json                 @default("[]")
  /// @kiorly/field-visit SafetyState (prompt / answer / alert timestamps).
  safetyState    Json                 @default("{}")

  order  LabOrder      @relation(fields: [orderId], references: [id])
  alerts SafetyAlert[]

  @@index([orgId, slotStart])
  @@index([phlebotomistId, slotStart])
}

/// KLORD05: a sample collected by a Kiorly Nurse visit and handed to this lab. No home address is kept (the visit stays in Kiorly Nurse).
model NurseCollection {
  id               String    @id @default(cuid())
  orgId            String
  orderId          String    @unique
  /// Nurse-side visit / appointment id (provenance).
  nurseVisitRef    String
  /// Nurse (clinician) reference, never a phone or national id.
  collectorRef     String
  collectorName    String?
  /// Custody starts here (the nurse's clock), not at ingest.
  collectedAt      DateTime
  handedOverAt     DateTime?
  temperatureC     Decimal?  @db.Decimal(5, 2)
  /// sha256 of the LAB_RESULTS record-share consent token; the plaintext is never stored.
  consentTokenHash String
  receivedAt       DateTime?
  createdAt        DateTime  @default(now())

  order LabOrder @relation(fields: [orderId], references: [id])

  @@index([orgId, collectedAt])
}

/// HVSAF01/02 + BR61 for phlebotomists. Ids and coarse position only; precise SOS location is delivered, never stored.
model SafetyAlert {
  id               String          @id @default(cuid())
  orgId            String
  homeCollectionId String
  kind             SafetyAlertKind
  raisedAt         DateTime        @default(now())
  dueAt            DateTime
  delivered        Boolean         @default(false)
  deliveredAt      DateTime?
  latencyMs        Int?
  withinSla        Boolean?
  attempts         Json            @default("[]")
  lastGeostamp     Json?

  homeCollection HomeCollection @relation(fields: [homeCollectionId], references: [id])

  @@index([orgId, raisedAt])
  @@index([homeCollectionId])
}

// -------------------------------------------------------------- specimens ---

/// KLSPC01/02: unique accession per lab; aliquots link to parent.
model Specimen {
  id               String           @id @default(cuid())
  orgId            String
  labId            String
  orderId          String
  accessionNumber  String
  /// Barcode payload printed on the label; scan must match on receipt/processing.
  barcode          String
  specimenType     String
  container        String?
  parentSpecimenId String?
  status           SpecimenStatus   @default(PENDING_COLLECTION)
  rejectionReason  RejectionReason?
  rejectionNote    String?
  recollectOfId    String?
  collectedAt      DateTime?
  /// KLORD05: collector (nurse) reference when the sample arrived pre-collected.
  collectedByRef   String?
  labelsPrinted    Int              @default(0)
  createdAt        DateTime         @default(now())
  /// Volume on hand (mL); aliquoting/splitting draws it down.
  volumeMl         Decimal?         @db.Decimal(8, 2)
  /// Retention window of a stored sample (RetentionRule, default 7 days); disposal list = STORED past this date.
  retentionUntil   DateTime?

  lab      Lab            @relation(fields: [labId], references: [id])
  order    LabOrder       @relation(fields: [orderId], references: [id])
  parent   Specimen?      @relation("Aliquots", fields: [parentSpecimenId], references: [id])
  aliquots Specimen[]     @relation("Aliquots")
  custody  CustodyEvent[]
  results  Result[]

  /// Stop-ship: duplicate accession accepted.
  @@unique([labId, accessionNumber])
  @@unique([labId, barcode])
  @@index([orgId, orderId])
}

/// KLSPC03: append-only chain of custody (DB trigger forbids UPDATE/DELETE).
model CustodyEvent {
  id           String           @id @default(cuid())
  orgId        String
  specimenId   String
  type         CustodyEventType
  actorId      String
  location     String?
  /// Transport temperature (KLSPC03 "time, temperature").
  temperatureC Decimal?         @db.Decimal(5, 2)
  note         String?
  occurredAt   DateTime         @default(now())

  specimen Specimen @relation(fields: [specimenId], references: [id])

  @@index([specimenId, occurredAt])
  @@index([orgId, occurredAt])
}

// ----------------------------------------------------------------- QC -------

model Instrument {
  id           String            @id @default(cuid())
  orgId        String
  labId        String
  name         String
  kind         InstrumentKind
  /// ASTM E1394 / HL7 v2 interface identifier (lab.analyzer_interfaces).
  interfaceRef String?
  model        String?
  protocol     AnalyzerProtocol?
  /// Sections this instrument serves (worklist filter). Empty = all.
  sections     LabSection[]      @default([])
  /// Simulated analyzer bridge (MODE=mock): no physical device.
  simulated    Boolean           @default(false)
  /// sha256 of the instrument API key used by the bridge to post messages.
  apiKeyHash   String?
  active       Boolean           @default(true)

  lab      Lab               @relation(fields: [labId], references: [id])
  qcRuns   QcRun[]
  qcBlocks QcBlock[]
  results  Result[]
  messages AnalyzerMessage[]

  @@index([orgId, labId])
}

/// Control material per analyte/level with target mean/SD (basis for Westgard evaluation).
model QcMaterialLevel {
  id           String      @id @default(cuid())
  orgId        String
  analyteId    String
  level        QcLevel
  materialLot  String
  targetMean   Decimal     @db.Decimal(14, 5)
  targetSd     Decimal     @db.Decimal(14, 5)
  expiresAt    DateTime?   @db.Date
  /// QC lot management: manufacturer, date opened, ACTIVE/RETIRED (a retired lot accepts no new runs).
  manufacturer String?
  openedAt     DateTime?   @db.Date
  status       QcLotStatus @default(ACTIVE)

  analyte Analyte @relation(fields: [analyteId], references: [id])
  runs    QcRun[]

  @@unique([analyteId, level, materialLot])
}

/// KLQC02: internal QC run per analyte/level; Levey-Jennings plots zScore over time.
model QcRun {
  id            String      @id @default(cuid())
  orgId         String
  instrumentId  String
  materialId    String
  value         Decimal     @db.Decimal(14, 5)
  zScore        Decimal     @db.Decimal(8, 4)
  status        QcRunStatus
  /// Westgard rules violated, e.g. ["1_3s","2_2s","R_4s","4_1s","10x"].
  violatedRules String[]
  runBy         String
  runAt         DateTime    @default(now())

  instrument    Instrument      @relation(fields: [instrumentId], references: [id])
  material      QcMaterialLevel @relation(fields: [materialId], references: [id])
  openedBlocks  QcBlock[]       @relation("OpenedBy")
  clearedBlocks QcBlock[]       @relation("ClearedBy")
  results       Result[]

  @@index([instrumentId, materialId, runAt])
}

/// A FAIL (rule violation) opens a block: patient release for that analyte/instrument is refused until cleared by a documented passing run.
model QcBlock {
  id             String        @id @default(cuid())
  orgId          String
  instrumentId   String
  analyteId      String
  status         QcBlockStatus @default(OPEN)
  openedByRunId  String
  rule           String
  clearedByRunId String?
  clearedBy      String?
  clearNote      String?
  openedAt       DateTime      @default(now())
  clearedAt      DateTime?

  instrument   Instrument @relation(fields: [instrumentId], references: [id])
  openedByRun  QcRun      @relation("OpenedBy", fields: [openedByRunId], references: [id])
  clearedByRun QcRun?     @relation("ClearedBy", fields: [clearedByRunId], references: [id])

  @@index([orgId, instrumentId, analyteId, status])
}

// ---------------------------------------------------------------- results ---

/// KLQC01/03/04: result with source, dual control for manual entry, delta check, tech + medical validation.
model Result {
  id                      String       @id @default(cuid())
  orgId                   String
  orderItemId             String
  specimenId              String
  analyteId               String
  instrumentId            String?
  /// QC run that covers this result's analytical batch; required before release.
  qcRunId                 String?
  source                  ResultSource
  status                  ResultStatus @default(ENTERED)
  valueNumeric            Decimal?     @db.Decimal(14, 5)
  valueText               String?
  unit                    String?
  flag                    ResultFlag   @default(NORMAL)
  /// Reference interval version used at the time (KLQC03).
  referenceIntervalId     String?
  deltaCheckFailed        Boolean      @default(false)
  enteredBy               String
  /// KLQC01: manual entry with dual control => second person re-keys/confirms.
  secondEntryBy           String?
  techValidatedBy         String?
  techValidatedAt         DateTime?
  medicalValidatedBy      String?
  medicalValidatedAt      DateTime?
  releasedAt              DateTime?
  /// Signed report version this result was released in (required to release).
  releasedReportVersionId String?
  enteredAt               DateTime     @default(now())
  /// Interval snapshot shown on the report.
  refLow                  Decimal?     @db.Decimal(12, 4)
  refHigh                 Decimal?     @db.Decimal(12, 4)
  deltaPercent            Decimal?     @db.Decimal(9, 2)
  autoVerified            Boolean      @default(false)
  analyzerMessageId       String?
  /// Rerun / dilution: the repeat run links to the rejected first run; value = rawValue x dilutionFactor.
  rerunOfId               String?
  dilutionFactor          Decimal?     @db.Decimal(10, 4)
  rawValue                Decimal?     @db.Decimal(14, 5)
  /// Calculated results: analyte ids of the inputs (QC blocks on any input block the derived value).
  derivedFromIds          String[]     @default([])
  /// KLQC05: a correction supersedes the prior result row.
  supersedesResultId      String?
  correctionReason        String?

  orderItem             OrderItem       @relation(fields: [orderItemId], references: [id])
  specimen              Specimen        @relation(fields: [specimenId], references: [id])
  analyte               Analyte         @relation(fields: [analyteId], references: [id])
  instrument            Instrument?     @relation(fields: [instrumentId], references: [id])
  qcRun                 QcRun?          @relation(fields: [qcRunId], references: [id])
  criticalAlerts        CriticalAlert[]
  releasedReportVersion ReportVersion?  @relation("ReleasedIn", fields: [releasedReportVersionId], references: [id])

  @@index([orgId, orderItemId])
  @@index([specimenId])
  @@index([analyteId, instrumentId, enteredAt])
}

/// KLQC05: corrected reports create a new version with reason; recipients notified.
/// A report version is signed by an authorized signatory (DB CHECK: signer + timestamp present).
model ReportVersion {
  id               String   @id @default(cuid())
  orgId            String
  orderId          String
  version          Int
  /// Required when version > 1.
  correctionReason String?
  supersedesId     String?
  signedBy         String
  signedAt         DateTime
  /// Integrity: SHA-256 of the rendered report document.
  contentHash      String
  storageKey       String
  sizeBytes        Int      @default(0)
  createdAt        DateTime @default(now())

  order           LabOrder          @relation(fields: [orderId], references: [id])
  releases        ReleaseRecord[]
  releasedResults Result[]          @relation("ReleasedIn")
  shareLinks      ReportShareLink[]

  @@unique([orderId, version])
  @@index([orgId, orderId])
}

/// KLCRIT02/03: each release channel is consent-checked; event carries signed version + secure link, never raw values.
model ReleaseRecord {
  id              String         @id @default(cuid())
  orgId           String
  reportVersionId String
  channel         ReleaseChannel
  /// Consent reference (order.consentCapturedAt snapshot / external token).
  consentRef      String
  /// Opaque id for the patient secure link (OTP-gated). Not the link itself.
  secureLinkId    String?
  releasedBy      String
  releasedAt      DateTime       @default(now())

  reportVersion ReportVersion @relation(fields: [reportVersionId], references: [id])

  @@index([orgId, reportVersionId])
}

/// KLCRIT01: ack within configured minutes or escalate to lab director.
model CriticalAlert {
  id                String              @id @default(cuid())
  orgId             String
  resultId          String
  status            CriticalAlertStatus @default(OPEN)
  notifiedUserRef   String
  notifiedAt        DateTime            @default(now())
  /// notifiedAt + rule.ackWithinMinutes; a timer job escalates when passed and not acknowledged.
  ackDeadlineAt     DateTime
  acknowledgedBy    String?
  acknowledgedAt    DateTime?
  /// Read-back note captured at acknowledgement (web or app); single source of truth. Free text, may carry clinical detail: never put in notifications.
  readBackNote      String?
  escalatedToUserId String?
  escalatedAt       DateTime?
  escalationLevel   Int                 @default(0)
  orderId           String?
  closedAt          DateTime?

  result Result @relation(fields: [resultId], references: [id])

  @@index([orgId, status, ackDeadlineAt])
}

// ------------------------------------------------------ platform plumbing ---

/// Transactional outbox (ADR-006): LabResultReleased carries signed version + secure link only.
model OutboxEvent {
  id            String       @id @default(cuid())
  orgId         String
  type          String
  aggregateType String
  aggregateId   String
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  target        String       @default("KIOREX")
  nextAttemptAt DateTime     @default(now())
  lastError     String?
  occurredAt    DateTime     @default(now())
  sentAt        DateTime?

  @@index([status, occurredAt])
  @@index([orgId])
}

model AuditLog {
  id         String   @id @default(cuid())
  orgId      String
  actorId    String?
  action     String
  entityType String
  entityId   String
  /// No PHI here: ids and field names only.
  meta       Json?
  at         DateTime @default(now())

  @@index([orgId, at])
  @@index([entityType, entityId])
}

model FlagSnapshotCache {
  product   String   @id
  version   String
  etag      String?
  body      Json
  fetchedAt DateTime @default(now())
}

// ------------------------------------------------------- freeze-v1 additions ---

/// Atomic sequence counters (accession per lab per day, order and invoice numbers). key e.g. "acc:<labId>:20261120".
model SequenceCounter {
  orgId String
  key   String
  value Int    @default(0)

  @@id([orgId, key])
}

model CollectionSlot {
  id       String   @id @default(cuid())
  orgId    String
  labId    String
  startsAt DateTime
  endsAt   DateTime
  capacity Int      @default(4)
  booked   Int      @default(0)

  lab Lab @relation(fields: [labId], references: [id])

  @@unique([labId, startsAt])
  @@index([orgId, startsAt])
}

/// KLQC01: auto-verification (never replaces medical validation or release).
model AutoVerificationRule {
  id               String   @id @default(cuid())
  orgId            String
  analyteId        String
  enabled          Boolean  @default(false)
  /// Delta check: fail when |change| exceeds this percent of the prior value. NULL = no delta check. NEEDS_HUMAN (NH-LB-013).
  maxDeltaPercent  Decimal? @db.Decimal(9, 2)
  /// Only auto-verify results inside the reference interval.
  requireNormal    Boolean  @default(true)
  /// Delta check on the absolute change (same unit as the analyte) and the look-back window (days; null = any prior).
  maxDeltaAbsolute Decimal? @db.Decimal(14, 4)
  deltaWindowDays  Int?

  analyte Analyte @relation(fields: [analyteId], references: [id])

  @@unique([orgId, analyteId])
}

/// Raw analyzer traffic (ASTM E1394 / HL7 v2). Contains patient identifiers: never logged, tenant-scoped.
model AnalyzerMessage {
  id           String                @id @default(cuid())
  orgId        String
  instrumentId String
  protocol     AnalyzerProtocol
  raw          String
  status       AnalyzerMessageStatus
  error        String?
  resultCount  Int                   @default(0)
  receivedAt   DateTime              @default(now())

  instrument Instrument @relation(fields: [instrumentId], references: [id])

  @@index([orgId, instrumentId, receivedAt])
}

model ReportShareLink {
  id              String    @id @default(cuid())
  orgId           String
  reportVersionId String
  /// sha256 of the token in the URL; the token itself is never stored.
  tokenHash       String    @unique
  otpHash         String?
  otpExpiresAt    DateTime?
  otpAttempts     Int       @default(0)
  verifiedAt      DateTime?
  expiresAt       DateTime
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())

  reportVersion ReportVersion @relation(fields: [reportVersionId], references: [id])

  @@index([orgId, reportVersionId])
}

/// Mock/real messaging attempts (dev inbox). params never carry raw result values.
model NotificationAttempt {
  id                String              @id @default(cuid())
  orgId             String
  channel           NotificationChannel
  purpose           NotificationPurpose
  recipientRef      String
  /// TODO_NEEDS_HUMAN placeholder id until a template is approved (NH-LB-018).
  templateId        String
  params            Json?
  status            NotificationStatus  @default(QUEUED)
  attemptNo         Int                 @default(1)
  providerMessageId String?
  error             String?
  relatedType       String?
  relatedId         String?
  createdAt         DateTime            @default(now())
  deliveredAt       DateTime?

  @@index([orgId, createdAt])
  @@index([relatedType, relatedId])
}

model PriceList {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  isDefault Boolean  @default(false)
  currency  String   @default("EGP")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  items    PriceListItem[]
  accounts B2bAccount[]

  @@unique([orgId, name])
}

/// Versioned: a price change closes the current row (effectiveTo) and inserts version+1. Never edited in place.
model PriceListItem {
  id            String    @id @default(cuid())
  orgId         String
  priceListId   String
  testId        String?
  packageId     String?
  amount        Decimal   @db.Decimal(14, 2)
  version       Int       @default(1)
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  createdBy     String?

  priceList PriceList @relation(fields: [priceListId], references: [id])

  @@index([priceListId, testId, effectiveTo])
  @@index([orgId])
}

/// KLBIZ01: payer contract / B2B account.
model B2bAccount {
  id               String    @id @default(cuid())
  orgId            String
  name             String
  priceListId      String?
  paymentTermsDays Int       @default(30)
  creditLimit      Decimal?  @db.Decimal(14, 2)
  active           Boolean   @default(true)
  createdAt        DateTime  @default(now())
  /// Contract: CORPORATE | INSURANCE. discountPercent applies to every invoice; coveragePercent = share of the invoice the payer settles (the patient pays the rest).
  kind             String    @default("CORPORATE")
  discountPercent  Decimal   @default(0) @db.Decimal(5, 2)
  coveragePercent  Decimal   @default(0) @db.Decimal(5, 2)
  contractRef      String?
  contractStart    DateTime? @db.Date
  contractEnd      DateTime? @db.Date
  billingEmail     String?

  priceList PriceList? @relation(fields: [priceListId], references: [id])
  orders    LabOrder[]
  invoices  Invoice[]

  @@unique([orgId, name])
}

/// Invoices carry VAT LINES only (display/export). No tax-authority submission anywhere (ADR-011).
model Invoice {
  id             String        @id @default(cuid())
  orgId          String
  labId          String
  orderId        String?
  b2bAccountId   String?
  number         String
  status         InvoiceStatus @default(DRAFT)
  currency       String        @default("EGP")
  /// subtotal = net of discounts, before VAT (revenue). grossSubtotal = sum of line list prices.
  subtotal       Decimal       @db.Decimal(14, 2)
  grossSubtotal  Decimal       @default(0) @db.Decimal(14, 2)
  discountTotal  Decimal       @default(0) @db.Decimal(14, 2)
  discountReason String?
  /// Part of the total the B2B/insurance payer settles (the rest is the patient's).
  payerAmount    Decimal       @default(0) @db.Decimal(14, 2)
  dueAt          DateTime?
  vatRatePercent Decimal       @db.Decimal(5, 2)
  vatTotal       Decimal       @db.Decimal(14, 2)
  total          Decimal       @db.Decimal(14, 2)
  paidTotal      Decimal       @default(0) @db.Decimal(14, 2)
  issuedAt       DateTime?
  createdBy      String
  createdAt      DateTime      @default(now())

  order      LabOrder?     @relation(fields: [orderId], references: [id])
  b2bAccount B2bAccount?   @relation(fields: [b2bAccountId], references: [id])
  lines      InvoiceLine[]
  payments   Payment[]

  @@unique([orgId, number])
  @@index([orgId, status])
}

model InvoiceLine {
  id             String  @id @default(cuid())
  invoiceId      String
  description    String
  testId         String?
  quantity       Int     @default(1)
  unitPrice      Decimal @db.Decimal(14, 2)
  discountAmount Decimal @default(0) @db.Decimal(14, 2)
  vatRatePercent Decimal @db.Decimal(5, 2)
  vatAmount      Decimal @db.Decimal(14, 2)
  lineTotal      Decimal @db.Decimal(14, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

/// Money path: idempotency key (unique per org), ledger entries, outbox event, reconciliation test.
model Payment {
  id             String        @id @default(cuid())
  orgId          String
  labId          String
  invoiceId      String
  method         PaymentMethod
  status         PaymentStatus @default(PENDING)
  amount         Decimal       @db.Decimal(14, 2)
  idempotencyKey String
  pspRef         String?
  receivedBy     String
  createdAt      DateTime      @default(now())
  /// PATIENT | PAYER (B2B / insurance settlement).
  payer          String        @default("PATIENT")
  refundedAmount Decimal       @default(0) @db.Decimal(14, 2)
  /// Cheque / transfer reference.
  reference      String?

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@unique([orgId, idempotencyKey])
  @@index([orgId, labId, createdAt])
}

/// Append-only double-entry-style ledger (kernel-adapter local implementation). Debit/credit are positive amounts.
model LedgerEntry {
  id         String        @id @default(cuid())
  orgId      String
  refType    String
  refId      String
  debit      LedgerAccount
  credit     LedgerAccount
  amount     Decimal       @db.Decimal(14, 2)
  currency   String
  memo       String?
  occurredAt DateTime      @default(now())

  @@index([orgId, occurredAt])
  @@index([refType, refId])
}

model CashClose {
  id           String   @id @default(cuid())
  orgId        String
  labId        String
  businessDate DateTime @db.Date
  expectedCash Decimal  @db.Decimal(14, 2)
  countedCash  Decimal  @db.Decimal(14, 2)
  variance     Decimal  @db.Decimal(14, 2)
  closedBy     String
  closedAt     DateTime @default(now())
  note         String?

  @@unique([labId, businessDate])
}

/// KLBIZ03: cost paid to a referral lab for a send-out test.
model SendOutCost {
  id              String   @id @default(cuid())
  orgId           String
  orderItemId     String   @unique
  referralLabName String
  cost            Decimal  @db.Decimal(14, 2)
  recordedBy      String
  recordedAt      DateTime @default(now())

  orderItem OrderItem @relation(fields: [orderItemId], references: [id])
}

/// KLBIZ02: one SLA alert per order item (deduplicated).
model SlaAlert {
  id          String   @id @default(cuid())
  orgId       String
  orderItemId String   @unique
  level       String
  raisedAt    DateTime @default(now())

  orderItem OrderItem @relation(fields: [orderItemId], references: [id])
}

model IdempotencyRecord {
  orgId     String
  key       String
  scope     String
  response  Json
  createdAt DateTime @default(now())

  @@id([orgId, scope, key])
}

/// Inbound HMAC clients (Kiorex bookings, Kiorly Clinic handoff). secretEnc = AES-GCM(secret) with the platform KEK.
model IntegrationClient {
  id               String   @id @default(cuid())
  orgId            String
  key              String   @unique
  secretEnc        String
  /// KIOREX_BOOKING | KIORLY_CLINIC | KIORLY_NURSE
  source           String
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  /// KIOREX_BOOKING only: Kiorex API base (e.g. http://localhost:4000); outbox events go to `${base}/api/v1/webhooks/lab`.
  kiorexBaseUrl    String?
  /// Per-partner webhook signing secret (AES-GCM sealed). Kiorex verifies it via X-Kiorly-Client-Key.
  webhookSecretEnc String?

  @@index([orgId])
}

// ============================================================ registry (M1) ====

enum ReferrerKind {
  DOCTOR
  CLINIC
  HOSPITAL
  CORPORATE
}

enum CommissionType {
  NONE
  PERCENT
  FIXED
}

enum ConsentKind {
  RESULT_SHARING
  DATA_PROCESSING
  MARKETING
  RESEARCH
}

enum ReferrerAccount {
  /// What the lab owes the referrer (commission accrued - paid out).
  COMMISSION
  /// What the referrer owes the lab (credit sales - payments).
  CREDIT
}

/// Consent history (append-only): the latest row per kind is the current state.
model PatientConsent {
  id         String      @id @default(cuid())
  orgId      String
  patientId  String
  kind       ConsentKind
  granted    Boolean
  /// Wording version shown to the patient (wording itself is NEEDS_HUMAN NH-LB-007).
  version    String      @default("v0")
  channel    String      @default("DESK")
  capturedBy String
  note       String?
  capturedAt DateTime    @default(now())

  patient PatientRef @relation(fields: [patientId], references: [id])

  @@index([orgId, patientId, kind, capturedAt])
}

/// Referring doctors / clinics directory with delivery preferences and commission / credit accounts.
model Referrer {
  id               String                @id @default(cuid())
  orgId            String
  kind             ReferrerKind          @default(DOCTOR)
  name             String
  specialty        String?
  phone            String?
  email            String?
  address          String?
  licenceNo        String?
  /// Delivery preferences: which channels get the released report automatically (needs patient consent per order).
  deliveryChannels NotificationChannel[] @default([])
  deliverOnRelease Boolean               @default(false)
  preferredLocale  String                @default("ar")
  commissionType   CommissionType        @default(NONE)
  commissionValue  Decimal               @default(0) @db.Decimal(14, 2)
  creditLimit      Decimal?              @db.Decimal(14, 2)
  paymentTermsDays Int                   @default(30)
  /// sha256 of the doctor-portal token (the token is shown once at creation).
  portalTokenHash  String?               @unique
  active           Boolean               @default(true)
  createdAt        DateTime              @default(now())

  orders LabOrder[]
  ledger ReferrerLedgerEntry[]

  @@index([orgId, name])
}

/// Append-only commission / credit ledger. amount > 0 increases the balance, < 0 decreases it.
model ReferrerLedgerEntry {
  id         String          @id @default(cuid())
  orgId      String
  referrerId String
  account    ReferrerAccount
  /// COMMISSION_ACCRUED | COMMISSION_PAYOUT | CREDIT_CHARGE | CREDIT_PAYMENT | ADJUSTMENT
  type       String
  amount     Decimal         @db.Decimal(14, 2)
  orderId    String?
  invoiceId  String?
  memo       String?
  createdBy  String
  createdAt  DateTime        @default(now())

  referrer Referrer @relation(fields: [referrerId], references: [id])

  @@unique([referrerId, type, invoiceId])
  @@index([orgId, referrerId, createdAt])
}

// ======================================================= order entry (M2) ====

enum AppointmentStatus {
  BOOKED
  CHECKED_IN
  COMPLETED
  NO_SHOW
  CANCELLED
}

enum QueueStatus {
  WAITING
  CALLED
  SERVING
  DONE
  SKIPPED
  CANCELLED
}

/// Walk-in / package / home-visit appointment (separate from home-collection slots; those stay in CollectionSlot).
model Appointment {
  id          String            @id @default(cuid())
  orgId       String
  labId       String
  patientId   String?
  patientName String
  phone       String?
  startsAt    DateTime
  endsAt      DateTime
  /// WALK_IN | PACKAGE | HOME | FOLLOW_UP
  kind        String            @default("WALK_IN")
  testCodes   String[]          @default([])
  packageCode String?
  fasting     Boolean           @default(false)
  status      AppointmentStatus @default(BOOKED)
  note        String?
  orderId     String?
  createdBy   String
  createdAt   DateTime          @default(now())
  checkedInAt DateTime?

  @@index([orgId, labId, startsAt])
}

/// Reception queue / token display. Code is per lab per day (A001 routine, S001 STAT/urgent priority lane).
model QueueTicket {
  id            String      @id @default(cuid())
  orgId         String
  labId         String
  businessDate  DateTime    @db.Date
  seq           Int
  code          String
  priority      String      @default("ROUTINE")
  patientName   String?
  counter       String?
  status        QueueStatus @default(WAITING)
  orderId       String?
  appointmentId String?
  calledAt      DateTime?
  servedAt      DateTime?
  doneAt        DateTime?
  createdAt     DateTime    @default(now())

  @@unique([labId, businessDate, code])
  @@index([orgId, labId, businessDate, status])
}

/// Visible edit history of an order (audit log keeps ids only; this keeps field-level from/to for non-identity fields).
model OrderRevision {
  id        String   @id @default(cuid())
  orgId     String
  orderId   String
  revision  Int
  changedBy String
  changes   Json
  reason    String?
  at        DateTime @default(now())

  @@unique([orderId, revision])
  @@index([orgId, orderId])
}

// ====================================================== pre-analytics (M3) ====

enum StorageKind {
  FRIDGE
  FREEZER_MINUS20
  FREEZER_MINUS80
  ROOM_TEMP
  RACK
}

enum RecollectionStatus {
  REQUESTED
  NOTIFIED
  COLLECTED
  CANCELLED
}

enum ManifestKind {
  INTER_BRANCH
  SEND_OUT
}

enum ManifestStatus {
  DRAFT
  DISPATCHED
  IN_TRANSIT
  DELIVERED
  RECEIVED
  CANCELLED
}

/// Freezer / fridge / rack with a rows x cols grid of slots (A1..).
model StorageUnit {
  id        String      @id @default(cuid())
  orgId     String
  labId     String
  name      String
  kind      StorageKind @default(FRIDGE)
  rows      Int         @default(8)
  cols      Int         @default(12)
  tempMinC  Decimal?    @db.Decimal(5, 1)
  tempMaxC  Decimal?    @db.Decimal(5, 1)
  active    Boolean     @default(true)
  createdAt DateTime    @default(now())

  assignments StorageAssignment[]

  @@unique([labId, name])
  @@index([orgId])
}

/// Where a specimen lives. A partial unique index (unitId, slot) WHERE releasedAt IS NULL forbids two specimens in one slot.
model StorageAssignment {
  id         String    @id @default(cuid())
  orgId      String
  specimenId String
  unitId     String
  slot       String
  assignedBy String
  assignedAt DateTime  @default(now())
  releasedAt DateTime?
  releasedBy String?

  unit StorageUnit @relation(fields: [unitId], references: [id])

  @@index([specimenId])
  @@index([orgId, unitId, releasedAt])
}

model RetentionRule {
  id            String @id @default(cuid())
  orgId         String
  specimenType  String
  retentionDays Int

  @@unique([orgId, specimenType])
}

/// Rejection -> recollection workflow (one per rejected specimen).
model RecollectionRequest {
  id                 String             @id @default(cuid())
  orgId              String
  orderId            String
  rejectedSpecimenId String             @unique
  newSpecimenId      String?
  reason             RejectionReason
  note               String?
  status             RecollectionStatus @default(REQUESTED)
  requestedBy        String
  notifiedAt         DateTime?
  resolvedAt         DateTime?
  createdAt          DateTime           @default(now())

  @@index([orgId, status])
}

model Courier {
  id      String  @id @default(cuid())
  orgId   String
  name    String
  phone   String?
  company String?
  active  Boolean @default(true)

  @@unique([orgId, name])
}

/// Transport of specimens between branches or to a referral (send-out) lab, with courier tracking.
model TransportManifest {
  id              String         @id @default(cuid())
  orgId           String
  number          String
  kind            ManifestKind
  status          ManifestStatus @default(DRAFT)
  fromLabId       String
  toLabId         String?
  /// Referral lab / hospital name for SEND_OUT.
  destinationName String?
  courierId       String?
  courierName     String?
  courierPhone    String?
  /// Opaque public tracking reference (no PHI): /public/track/:ref.
  trackingRef     String         @unique
  temperatureC    Decimal?       @db.Decimal(5, 1)
  note            String?
  dispatchedAt    DateTime?
  deliveredAt     DateTime?
  receivedAt      DateTime?
  receivedBy      String?
  createdBy       String
  createdAt       DateTime       @default(now())

  items  ManifestItem[]
  events CourierEvent[]

  @@unique([orgId, number])
  @@index([orgId, status])
}

model ManifestItem {
  id         String    @id @default(cuid())
  orgId      String
  manifestId String
  specimenId String
  /// PACKED | RECEIVED | MISSING
  status     String    @default("PACKED")
  receivedAt DateTime?
  note       String?

  manifest TransportManifest @relation(fields: [manifestId], references: [id], onDelete: Cascade)

  @@unique([manifestId, specimenId])
  @@index([orgId, specimenId])
}

model CourierEvent {
  id           String   @id @default(cuid())
  orgId        String
  manifestId   String
  /// PICKED_UP | IN_TRANSIT | DELAYED | DELIVERED | NOTE
  status       String
  location     String?
  note         String?
  temperatureC Decimal? @db.Decimal(5, 1)
  by           String
  at           DateTime @default(now())

  manifest TransportManifest @relation(fields: [manifestId], references: [id], onDelete: Cascade)

  @@index([manifestId, at])
}

// ============================================================ analytics (M4) ====

enum LabSection {
  GENERAL
  HEMATOLOGY
  CHEMISTRY
  IMMUNOLOGY
  SEROLOGY
  COAGULATION
  URINALYSIS
  MICROBIOLOGY
  HISTOPATHOLOGY
  CYTOLOGY
  MOLECULAR
}

enum AnalyteValueType {
  NUMERIC
  TEXT
  SEMI_QUANT
  CHOICE
}

enum RerunStatus {
  OPEN
  DONE
  CANCELLED
}

enum MicroStatus {
  RECEIVED
  INCUBATING
  PRELIMINARY
  FINAL
}

enum Susceptibility {
  S
  I
  R
  SDD
  NS
}

enum HistoKind {
  HISTOPATHOLOGY
  CYTOLOGY
}

enum HistoStatus {
  RECEIVED
  GROSSING
  PROCESSING
  REPORTING
  SIGNED_OUT
}

/// Repeat / dilute request on a result. The first run is REJECTED; the repeat links back through Result.rerunOfId.
model RerunRequest {
  id               String      @id @default(cuid())
  orgId            String
  orderItemId      String
  analyteId        String
  originalResultId String
  reason           String
  dilutionFactor   Decimal?    @db.Decimal(10, 4)
  status           RerunStatus @default(OPEN)
  requestedBy      String
  newResultId      String?
  createdAt        DateTime    @default(now())
  doneAt           DateTime?

  @@index([orgId, status])
  @@index([orderItemId, analyteId, status])
}

model Organism {
  id     String  @id @default(cuid())
  orgId  String
  code   String
  nameEn String
  nameAr String?
  /// POS | NEG | YEAST | OTHER
  gram   String  @default("OTHER")
  active Boolean @default(true)

  isolates MicrobiologyIsolate[]

  @@unique([orgId, code])
}

model Antibiotic {
  id              String  @id @default(cuid())
  orgId           String
  code            String
  nameEn          String
  nameAr          String?
  antibioticClass String?
  active          Boolean @default(true)

  panelItems AntibioticPanelItem[]
  results    MicrobiologySusceptibility[]

  @@unique([orgId, code])
}

/// Antibiotic panel offered for an organism group (e.g. "Enterobacterales", "Staphylococcus").
model AntibioticPanel {
  id            String  @id @default(cuid())
  orgId         String
  name          String
  organismGroup String
  active        Boolean @default(true)

  items AntibioticPanelItem[]

  @@unique([orgId, name])
}

model AntibioticPanelItem {
  panelId      String
  antibioticId String
  orgId        String
  position     Int    @default(0)

  panel      AntibioticPanel @relation(fields: [panelId], references: [id], onDelete: Cascade)
  antibiotic Antibiotic      @relation(fields: [antibioticId], references: [id])

  @@id([panelId, antibioticId])
}

/// Culture & sensitivity case for a microbiology order item.
model MicrobiologyCase {
  id                  String      @id @default(cuid())
  orgId               String
  orderItemId         String      @unique
  specimenId          String
  /// Collection site / source (urine, wound swab, blood culture ...).
  site                String?
  gramStain           String?
  cultureMedia        String[]    @default([])
  incubationStartedAt DateTime?
  status              MicroStatus @default(RECEIVED)
  /// null until read; true = growth, false = no growth.
  growth              Boolean?
  comment             String?
  enteredBy           String
  finalizedBy         String?
  finalizedAt         DateTime?
  resultId            String?
  createdAt           DateTime    @default(now())

  isolates MicrobiologyIsolate[]

  @@index([orgId, status])
}

model MicrobiologyIsolate {
  id         String   @id @default(cuid())
  orgId      String
  caseId     String
  organismId String
  isolateNo  Int      @default(1)
  /// e.g. ">10^5 CFU/mL", "heavy growth".
  quantity   String?
  note       String?
  createdAt  DateTime @default(now())

  microCase        MicrobiologyCase             @relation(fields: [caseId], references: [id], onDelete: Cascade)
  organism         Organism                     @relation(fields: [organismId], references: [id])
  susceptibilities MicrobiologySusceptibility[]

  @@unique([caseId, isolateNo])
}

model MicrobiologySusceptibility {
  id             String         @id @default(cuid())
  orgId          String
  isolateId      String
  antibioticId   String
  /// DISK | MIC | ETEST
  method         String         @default("DISK")
  micMgL         Decimal?       @db.Decimal(10, 4)
  zoneMm         Int?
  interpretation Susceptibility
  /// Selective reporting: only reported rows appear on the patient report.
  reported       Boolean        @default(true)

  isolate    MicrobiologyIsolate @relation(fields: [isolateId], references: [id], onDelete: Cascade)
  antibiotic Antibiotic          @relation(fields: [antibioticId], references: [id])

  @@unique([isolateId, antibioticId])
}

/// Basic histopathology / cytology report workflow.
model HistoCase {
  id                     String      @id @default(cuid())
  orgId                  String
  orderItemId            String      @unique
  specimenId             String
  kind                   HistoKind   @default(HISTOPATHOLOGY)
  site                   String?
  clinicalHistory        String?
  grossDescription       String?
  microscopicDescription String?
  diagnosis              String?
  /// ICD-O morphology / SNOMED-style code, free text (no coding service).
  morphologyCode         String?
  synoptic               Json?
  blocks                 Int         @default(0)
  slides                 Int         @default(0)
  status                 HistoStatus @default(RECEIVED)
  pathologistId          String?
  signedOutAt            DateTime?
  resultId               String?
  createdBy              String
  createdAt              DateTime    @default(now())

  addenda HistoAddendum[]

  @@index([orgId, status])
}

/// Addenda after sign-out (append-only; the signed diagnosis is never edited).
model HistoAddendum {
  id      String   @id @default(cuid())
  orgId   String
  caseId  String
  text    String
  addedBy String
  addedAt DateTime @default(now())

  histoCase HistoCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
}

// ============================================================ quality (M5) ====

enum QcLotStatus {
  ACTIVE
  RETIRED
}

enum CalibrationStatus {
  PASS
  FAIL
}

enum EqaStatus {
  ACCEPTABLE
  WARNING
  UNACCEPTABLE
}

enum MaintKind {
  PREVENTIVE
  CORRECTIVE
  CLEANING
  CALIBRATION
  PARTS
}

enum NcArea {
  PRE_ANALYTICAL
  ANALYTICAL
  POST_ANALYTICAL
  EQUIPMENT
  DOCUMENT
  PERSONNEL
  SAFETY
  OTHER
}

enum NcSeverity {
  MINOR
  MAJOR
  CRITICAL
}

enum NcStatus {
  OPEN
  INVESTIGATING
  ACTION
  VERIFIED
  CLOSED
}

enum CapaKind {
  CORRECTIVE
  PREVENTIVE
}

enum CapaStatus {
  OPEN
  DONE
  VERIFIED
}

enum DocCategory {
  SOP
  POLICY
  FORM
  MANUAL
  WORK_INSTRUCTION
}

enum DocStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  SUPERSEDED
}

model CalibrationRecord {
  id               String            @id @default(cuid())
  orgId            String
  instrumentId     String
  analyteId        String?
  calibratorLot    String
  calibratorExpiry DateTime?         @db.Date
  status           CalibrationStatus
  slope            Decimal?          @db.Decimal(14, 6)
  intercept        Decimal?          @db.Decimal(14, 6)
  performedBy      String
  performedAt      DateTime          @default(now())
  nextDueAt        DateTime?
  note             String?

  @@index([orgId, instrumentId, performedAt])
}

/// Proficiency testing / external quality assessment result. z = (reported - assigned) / group SD.
model EqaEvent {
  id            String    @id @default(cuid())
  orgId         String
  scheme        String
  cycle         String
  sampleCode    String
  analyteId     String
  instrumentId  String?
  reportedValue Decimal   @db.Decimal(14, 5)
  assignedValue Decimal   @db.Decimal(14, 5)
  groupSd       Decimal   @db.Decimal(14, 5)
  zScore        Decimal   @db.Decimal(8, 3)
  status        EqaStatus
  note          String?
  ncrId         String?
  enteredBy     String
  submittedAt   DateTime  @default(now())

  @@index([orgId, analyteId, submittedAt])
}

model MaintenanceSchedule {
  id            String    @id @default(cuid())
  orgId         String
  instrumentId  String
  task          String
  frequencyDays Int
  lastDoneAt    DateTime?
  nextDueAt     DateTime
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())

  @@index([orgId, instrumentId, nextDueAt])
}

model MaintenanceLog {
  id              String    @id @default(cuid())
  orgId           String
  instrumentId    String
  scheduleId      String?
  kind            MaintKind
  performedBy     String
  performedAt     DateTime  @default(now())
  notes           String?
  downtimeMinutes Int       @default(0)
  partsReplaced   String?

  @@index([orgId, instrumentId, performedAt])
}

/// Non-conformance report with root cause and CAPA actions.
model Ncr {
  id          String     @id @default(cuid())
  orgId       String
  number      String
  title       String
  description String
  area        NcArea     @default(OTHER)
  severity    NcSeverity @default(MINOR)
  status      NcStatus   @default(OPEN)
  /// MANUAL | QC | EQA | COMPLAINT | AUDIT | SPECIMEN | INSTRUMENT
  source      String     @default("MANUAL")
  relatedType String?
  relatedId   String?
  rootCause   String?
  containment String?
  raisedBy    String
  closedBy    String?
  closedAt    DateTime?
  createdAt   DateTime   @default(now())

  actions CapaAction[]

  @@unique([orgId, number])
  @@index([orgId, status])
}

model CapaAction {
  id            String     @id @default(cuid())
  orgId         String
  ncrId         String
  kind          CapaKind   @default(CORRECTIVE)
  description   String
  ownerId       String?
  dueAt         DateTime?
  status        CapaStatus @default(OPEN)
  completedAt   DateTime?
  effectiveness String?
  verifiedBy    String?
  createdAt     DateTime   @default(now())

  ncr Ncr @relation(fields: [ncrId], references: [id], onDelete: Cascade)

  @@index([orgId, status, dueAt])
}

/// Document control (light): SOPs, policies, forms with versions, review/approval and read-and-understood acknowledgements.
model QualityDocument {
  id        String      @id @default(cuid())
  orgId     String
  code      String
  title     String
  category  DocCategory @default(SOP)
  section   String?
  ownerId   String?
  active    Boolean     @default(true)
  createdAt DateTime    @default(now())

  versions QualityDocumentVersion[]

  @@unique([orgId, code])
}

model QualityDocumentVersion {
  id            String    @id @default(cuid())
  orgId         String
  documentId    String
  version       Int
  /// Markdown body.
  body          String
  status        DocStatus @default(DRAFT)
  authoredBy    String
  approvedBy    String?
  approvedAt    DateTime?
  effectiveFrom DateTime?
  reviewDueAt   DateTime?
  changeNote    String?
  createdAt     DateTime  @default(now())

  document QualityDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  acks     DocumentAck[]

  @@unique([documentId, version])
}

model DocumentAck {
  versionId String
  orgId     String
  staffId   String
  ackedAt   DateTime @default(now())

  version QualityDocumentVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@id([versionId, staffId])
}

// ========================================================== inventory (M6) ====

enum InventoryCategory {
  REAGENT
  CONSUMABLE
  CALIBRATOR
  CONTROL
  GENERAL
}

enum InventoryLotStatus {
  ACTIVE
  QUARANTINE
  EXPIRED
  DEPLETED
}

enum MovementType {
  RECEIPT
  CONSUMPTION
  ADJUSTMENT
  COUNT_VARIANCE
  DISPOSAL
}

enum PoStatus {
  DRAFT
  SENT
  PARTIAL
  RECEIVED
  CANCELLED
}

enum StockCountStatus {
  OPEN
  COMPLETED
}

model Supplier {
  id               String   @id @default(cuid())
  orgId            String
  name             String
  contactName      String?
  phone            String?
  email            String?
  address          String?
  leadTimeDays     Int      @default(7)
  paymentTermsDays Int      @default(30)
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())

  items InventoryItem[]
  pos   PurchaseOrder[]

  @@unique([orgId, name])
}

model InventoryItem {
  id           String            @id @default(cuid())
  orgId        String
  code         String
  name         String
  nameAr       String?
  category     InventoryCategory @default(REAGENT)
  /// Stock unit (mL, test, box, pcs).
  unit         String            @default("pcs")
  reorderLevel Decimal           @default(0) @db.Decimal(14, 3)
  reorderQty   Decimal           @default(0) @db.Decimal(14, 3)
  supplierId   String?
  storageTemp  String?
  /// Weighted average cost per stock unit (updated at each receipt) and the last paid cost.
  avgUnitCost  Decimal           @default(0) @db.Decimal(14, 4)
  lastUnitCost Decimal?          @db.Decimal(14, 4)
  active       Boolean           @default(true)
  createdAt    DateTime          @default(now())

  supplier Supplier?           @relation(fields: [supplierId], references: [id])
  lots     InventoryLot[]
  rules    ConsumptionRule[]
  poLines  PurchaseOrderLine[]

  @@unique([orgId, code])
}

model InventoryLot {
  id          String             @id @default(cuid())
  orgId       String
  itemId      String
  labId       String
  lotNumber   String
  expiryDate  DateTime?          @db.Date
  qtyReceived Decimal            @db.Decimal(14, 3)
  qtyOnHand   Decimal            @db.Decimal(14, 3)
  unitCost    Decimal            @default(0) @db.Decimal(14, 4)
  location    String?
  status      InventoryLotStatus @default(ACTIVE)
  receivedAt  DateTime           @default(now())

  item InventoryItem @relation(fields: [itemId], references: [id])

  @@unique([itemId, labId, lotNumber])
  @@index([orgId, itemId, status])
}

/// Append-only stock ledger. qty > 0 adds stock, < 0 removes it. `shortfall` = quantity wanted but not available (lotId null row).
model StockMovement {
  id        String       @id @default(cuid())
  orgId     String
  labId     String
  itemId    String
  lotId     String?
  type      MovementType
  qty       Decimal      @db.Decimal(14, 3)
  unitCost  Decimal?     @db.Decimal(14, 4)
  refType   String?
  refId     String?
  shortfall Decimal      @default(0) @db.Decimal(14, 3)
  memo      String?
  createdBy String
  createdAt DateTime     @default(now())

  @@index([orgId, itemId, createdAt])
  @@index([refType, refId])
}

/// Reagent-to-test consumption: running one order item of `testId` consumes qtyPerTest (+ wastage) of the item, first-expiry-first-out.
model ConsumptionRule {
  id             String  @id @default(cuid())
  orgId          String
  testId         String
  itemId         String
  qtyPerTest     Decimal @db.Decimal(14, 4)
  wastagePercent Decimal @default(0) @db.Decimal(5, 2)
  active         Boolean @default(true)

  item InventoryItem @relation(fields: [itemId], references: [id])

  @@unique([testId, itemId])
  @@index([orgId, testId])
}

model PurchaseOrder {
  id         String    @id @default(cuid())
  orgId      String
  labId      String
  number     String
  supplierId String
  status     PoStatus  @default(DRAFT)
  expectedAt DateTime?
  notes      String?
  total      Decimal   @default(0) @db.Decimal(14, 2)
  createdBy  String
  sentAt     DateTime?
  createdAt  DateTime  @default(now())

  supplier Supplier            @relation(fields: [supplierId], references: [id])
  lines    PurchaseOrderLine[]

  @@unique([orgId, number])
  @@index([orgId, status])
}

model PurchaseOrderLine {
  id          String  @id @default(cuid())
  orgId       String
  poId        String
  itemId      String
  qtyOrdered  Decimal @db.Decimal(14, 3)
  unitCost    Decimal @db.Decimal(14, 4)
  qtyReceived Decimal @default(0) @db.Decimal(14, 3)

  po   PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  item InventoryItem @relation(fields: [itemId], references: [id])
}

model GoodsReceipt {
  id         String   @id @default(cuid())
  orgId      String
  labId      String
  number     String
  poId       String?
  supplierId String
  invoiceRef String?
  note       String?
  receivedBy String
  receivedAt DateTime @default(now())

  lines GoodsReceiptLine[]

  @@unique([orgId, number])
}

model GoodsReceiptLine {
  id         String    @id @default(cuid())
  orgId      String
  receiptId  String
  itemId     String
  lotId      String
  lotNumber  String
  expiryDate DateTime? @db.Date
  qty        Decimal   @db.Decimal(14, 3)
  unitCost   Decimal   @db.Decimal(14, 4)

  receipt GoodsReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
}

model StockCount {
  id          String           @id @default(cuid())
  orgId       String
  labId       String
  number      String
  status      StockCountStatus @default(OPEN)
  note        String?
  createdBy   String
  createdAt   DateTime         @default(now())
  completedAt DateTime?
  completedBy String?

  lines StockCountLine[]

  @@unique([orgId, number])
}

model StockCountLine {
  id         String   @id @default(cuid())
  orgId      String
  countId    String
  itemId     String
  lotId      String
  systemQty  Decimal  @db.Decimal(14, 3)
  countedQty Decimal? @db.Decimal(14, 3)
  variance   Decimal? @db.Decimal(14, 3)

  count StockCount @relation(fields: [countId], references: [id], onDelete: Cascade)

  @@unique([countId, lotId])
}

// ========================================================= reporting (M7) ====

enum ReportLanguage {
  AR
  EN
  BILINGUAL
}

enum DeliveryStatus {
  SENT
  FAILED
}

/// Report layout/branding per lab: language mode, header/footer text, accent colour, logo, QR verification code. A signed report is rendered once
/// with the template active at signing time and stored; changing a template never alters a signed report.
model ReportTemplate {
  id             String         @id @default(cuid())
  orgId          String
  labId          String?
  name           String
  language       ReportLanguage @default(BILINGUAL)
  headerTitle    String?
  headerSubtitle String?
  footerText     String?
  accentColor    String         @default("#3730A3")
  showQr         Boolean        @default(true)
  showRanges     Boolean        @default(true)
  logo           Bytes?
  logoType       String?
  isDefault      Boolean        @default(false)
  active         Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @default(now()) @updatedAt

  @@unique([orgId, name])
  @@index([orgId, labId])
}

/// Mock/real delivery of a released report link to the patient or the referring doctor (email / WhatsApp / SMS). Never carries result values.
model ReportDelivery {
  id              String              @id @default(cuid())
  orgId           String
  reportVersionId String
  orderId         String
  /// PATIENT | REFERRER
  recipientType   String
  channel         NotificationChannel
  /// Masked recipient (e.g. +2010****111, a***@x.com).
  recipientMasked String
  status          DeliveryStatus
  notificationId  String?
  error           String?
  attempt         Int                 @default(1)
  trigger         String              @default("MANUAL")
  createdBy       String
  createdAt       DateTime            @default(now())

  @@index([orgId, reportVersionId])
}

// =========================================================== finance (M8) ====

enum ExpenseCategory {
  RENT
  SALARIES
  UTILITIES
  REAGENTS
  CONSUMABLES
  EQUIPMENT
  MAINTENANCE
  TRANSPORT
  MARKETING
  PROFESSIONAL_FEES
  OTHER
}

/// Partial/full refund of a payment (append-only; Payment.refundedAmount is the running total).
model Refund {
  id        String   @id @default(cuid())
  orgId     String
  labId     String
  paymentId String
  invoiceId String
  amount    Decimal  @db.Decimal(14, 2)
  reason    String?
  createdBy String
  createdAt DateTime @default(now())

  @@index([orgId, createdAt])
  @@index([paymentId])
}

/// Operating expense. fromDrawer = paid out of the cash drawer (reduces expected cash at close).
model Expense {
  id         String          @id @default(cuid())
  orgId      String
  labId      String
  date       DateTime        @db.Date
  category   ExpenseCategory @default(OTHER)
  amount     Decimal         @db.Decimal(14, 2)
  vendor     String?
  /// CASH | BANK | CARD
  paidVia    String          @default("CASH")
  fromDrawer Boolean         @default(false)
  reference  String?
  note       String?
  createdBy  String
  createdAt  DateTime        @default(now())
  voidedAt   DateTime?
  voidedBy   String?

  @@index([orgId, date])
}

// ------------------------------------------------- Kiorly (mobile) ----

enum MobileDeviceStatus {
  ACTIVE
  REVOKED
}

/// Kiorly staff app: one row per (staff, device). Device-bound token is stored hashed (sha256), never in clear.
model MobileDevice {
  id           String             @id @default(cuid())
  orgId        String
  staffId      String
  /// Client-generated UUID, stable per app install.
  deviceId     String
  platform     String
  name         String
  appVersion   String?
  tokenHash    String
  status       MobileDeviceStatus @default(ACTIVE)
  pushToken    String?
  pushProvider String?
  lastSeenAt   DateTime?
  revokedAt    DateTime?
  revokedBy    String?
  createdAt    DateTime           @default(now())

  @@unique([staffId, deviceId])
  @@index([orgId, status])
}

/// Mock push sender output = the staff in-app inbox (MODE=mock). Titles/bodies are bilingual and carry no raw result values.
model MobilePush {
  id          String    @id @default(cuid())
  orgId       String
  staffId     String
  /// GENERAL | SAFETY | CLINICAL | OPS
  kind        String
  templateId  String
  title       String
  titleAr     String
  body        String
  bodyAr      String
  data        Json      @default("{}")
  status      String    @default("DELIVERED")
  provider    String    @default("mock")
  createdAt   DateTime  @default(now())
  deliveredAt DateTime?
  readAt      DateTime?

  @@index([staffId, createdAt])
  @@index([orgId, staffId, readAt])
}

/// Kiorly: a staff member asked their org owner to upgrade to a plan that includes `mobile_staff_app`. Allowed on Basic (not entitlement-gated).
/// Repeat requests by the same staff member for the same feature within 24h are de-duplicated by the service.
model MobileUpgradeRequest {
  id            String   @id @default(cuid())
  orgId         String
  staffId       String
  role          String
  /// A module key (e.g. lab.qc) or "general".
  featureKey    String
  plan          String
  note          String?
  status        String   @default("OPEN")
  notifiedCount Int      @default(0)
  createdAt     DateTime @default(now())

  @@index([orgId, staffId, featureKey, createdAt])
  @@index([orgId, status, createdAt])
}

/// Acknowledgement of derived safety alerts (QC block, TAT breach, home-collection safety). Critical-value alerts ack on CriticalAlert itself.
model MobileAlertAck {
  id       String   @id @default(cuid())
  orgId    String
  alertKey String
  ackedBy  String
  note     String?
  ackedAt  DateTime @default(now())

  @@unique([orgId, alertKey])
}

enum PayLinkStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  REFUND_PENDING
  REFUNDED
}

/// Pay-by-link for an invoice (PAYMENT_MODE=mock|real). Status is driven by the signed PSP webhook; the paid link books a Payment (+ ledger) once.
model PayLink {
  id             String        @id @default(cuid())
  orgId          String
  invoiceId      String
  amount         Decimal       @db.Decimal(14, 2)
  currency       String        @default("EGP")
  status         PayLinkStatus @default(PENDING)
  /// Provider-side id of the link / charge (webhook correlation).
  providerRef    String?
  payUrl         String?
  idempotencyKey String
  /// Payment row booked when the link was paid.
  paymentId      String?
  failureReason  String?
  refundedAmount Decimal       @default(0) @db.Decimal(14, 2)
  /// Provider refund id while a refund is in flight.
  refundRef      String?
  refundAmount   Decimal?      @db.Decimal(14, 2)
  expiresAt      DateTime?
  createdBy      String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([orgId, idempotencyKey])
  @@index([providerRef])
  @@index([refundRef])
  @@index([orgId, invoiceId])
}

/// Webhook dedupe: a replayed provider event (same kind + event id) is a no-op.
model ProviderWebhookEvent {
  id         String   @id @default(cuid())
  kind       String
  eventId    String
  type       String
  receivedAt DateTime @default(now())

  @@unique([kind, eventId])
}

/// Kiorly Home sign-in handoff (ADR-038): a single-use, 30-second code that Home gets after a sign-in check and the product web redeems for the normal session.
/// Only the SHA-256 hash of the code is stored; `subjectId` is the StaffUser.id; `origin` is the Home origin it was issued for.
model HandoffCode {
  id        String    @id @default(cuid())
  codeHash  String    @unique
  product   String
  edition   String?
  origin    String
  subjectId String
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  @@index([expiresAt])
}
