{
  "name": "api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "typecheck": "prisma generate && tsc --noEmit -p tsconfig.json",
    "build": "prisma generate && nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev && prisma generate",
    "db:deploy": "prisma migrate deploy",
    "test": "npm run db:test:prepare && npm run test:unit && npm run test:e2e",
    "test:unit": "NODE_ENV=test node --require @swc-node/register --test \"src/**/*.node.test.ts\"",
    "test:e2e": "NODE_ENV=test node --require @swc-node/register --test --test-concurrency=1 \"test/**/*.e2e.test.ts\"",
    "db:test:prepare": "node scripts/prepare-test-db.mjs",
    "db:seed": "DEMO_SEED_ALLOWED=true tsx src/seed/seed.ts",
    "db:seed:demo": "DEMO_SEED_ALLOWED=true tsx src/seed/seed-demo.ts",
    "openapi": "rm -rf .tmp-openapi && tsc --ignoreConfig --outDir .tmp-openapi --rootDir . --module commonjs --target ES2022 --experimentalDecorators --emitDecoratorMetadata --esModuleInterop --skipLibCheck --strict --strictPropertyInitialization false --types node scripts/export-openapi.ts && node .tmp-openapi/scripts/export-openapi.js; rm -rf .tmp-openapi",
    "db:seed:dist": "node dist/seed/seed.js",
    "db:seed:demo:dist": "node dist/seed/seed-demo.js",
    "db:seed:mobile": "DEMO_SEED_ALLOWED=true tsx src/seed/seed-mobile.ts",
    "db:seed:mobile:dist": "node dist/seed/seed-mobile.js",
    "db:seed:lis": "DEMO_SEED_ALLOWED=true tsx src/seed/seed-lis.ts",
    "db:seed:lis:dist": "node dist/seed/seed-lis.js"
  },
  "dependencies": {
    "@kiorex/contracts": "file:../../vendor/kiorex-contracts-1.10.0.tgz",
    "@kiorly/field-visit": "file:../../vendor/kiorly-field-visit-0.1.0.tgz",
    "@kiorly/lab-shared": "*",
    "@nestjs/common": "^12.5.1",
    "@nestjs/core": "^12.5.1",
    "@nestjs/platform-express": "^12.5.1",
    "@nestjs/swagger": "^12.1.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^18.0.10",
    "jose": "^6.2.18",
    "pdfkit": "^0.21.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.15",
    "@nestjs/schematics": "^12.0.16",
    "@nestjs/testing": "^12.5.1",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.22",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.23.1",
    "fast-check": "^4.10.3",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
