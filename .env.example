DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/kiorly_lab?schema=public"
PORT=3200

# --- Auth (LB-F07). dev = HS256 dev tokens via /auth/dev-login (never in production); oidc = Kiorex Account JWKS (aud/iss validated)
AUTH_MODE=dev
JWT_DEV_SECRET=dev-only-secret-change-me-dev-only-secret
KIOREX_OIDC_ISSUER=http://localhost:4400
KIOREX_OIDC_AUDIENCE=kiorly-lab

# --- Provider adapters: every third party is MOCKED by default (<KIND>_MODE=mock|real). Going live = set MODE=real + the variables below (Docs/PROVIDERS.md, DEMO_DATA.md "Provider go-live checklist").
# Same names in Kiorly Clinic, Pharmacy and Lab. A real MODE without its URL/key/webhook secret/sender id REFUSES TO START (names only are logged).
# Legacy MESSAGING_MODE / PSP_MODE still work as the default for SMS+EMAIL+WHATSAPP / PAYMENT.
SMS_MODE=mock
# SMS_API_URL=https://<sms-gateway-base-url>
# SMS_API_KEY=<set in the secrets manager, never in git>
# SMS_WEBHOOK_SECRET=<delivery-receipt HMAC secret>
# SMS_SENDER_ID=<approved sender id>
EMAIL_MODE=mock
# EMAIL_API_URL=https://<email-gateway-base-url>
# EMAIL_API_KEY=<secret>
# EMAIL_WEBHOOK_SECRET=<secret>
# EMAIL_FROM=<verified from address>
WHATSAPP_MODE=mock
# WHATSAPP_API_URL=https://<whatsapp-gateway-base-url>
# WHATSAPP_API_KEY=<secret>
# WHATSAPP_WEBHOOK_SECRET=<secret>
# WHATSAPP_SENDER_ID=<business phone number id>
PAYMENT_MODE=mock
# PAYMENT_API_URL=https://<psp-gateway-base-url>
# PAYMENT_API_KEY=<secret>
# PAYMENT_WEBHOOK_SECRET=<secret>
# Push (Kiorly Team): PUSH_MODE (legacy MOBILE_PUSH_MODE) + PUSH_API_URL (Expo-compatible) [+ PUSH_API_KEY]
PUSH_MODE=mock
# PUSH_API_URL=https://exp.host/--/api/v2/push/send
# PUSH_API_KEY=<optional Expo access token>
STORAGE_MODE=mock
# STORAGE_API_URL=https://<object-store-gateway>   STORAGE_API_KEY=<secret>   (PUT/GET {url}/{key})
# Optional tuning for any kind: <KIND>_TIMEOUT_MS=8000  <KIND>_MAX_RETRIES=2  <KIND>_BACKOFF_MS=300
# Dev-only provider tools (/api/v1/dev/providers/*): always 404 in production; PROVIDER_DEV_TOOLS=false disables elsewhere.
PROVIDER_DEV_TOOLS=true
ANALYZER_MODE=mock
KIOREX_MODE=mock
STORAGE_DIR=./.data/storage
PUBLIC_BASE_URL=http://localhost:5191

# --- Kiorex outbox webhook (HMAC per KX-09) and flag.changed webhook secret
KIOREX_WEBHOOK_URL=http://localhost:4000/api/v1/webhooks/kiorly
KIOREX_WEBHOOK_SECRET=kx_dev_webhook_secret
KIOREX_FLAGS_WEBHOOK_SECRET=ff_dev_secret_change_me
INTEGRATION_KEK=dev-kek-change-me-dev-kek-change-me!
